# Dynamic dashboard environment ID (public identifier, not a wallet secret)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=replace-with-your-dynamic-environment-id

# Fill these only after deploying ReferralHub and creating the demo campaigns.
NEXT_PUBLIC_REFERRAL_HUB_ADDRESS=0xf8B23407977e7d741dD4cc8ed8De871117eA307a
NEXT_PUBLIC_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
NEXT_PUBLIC_NEWSLETTER_CAMPAIGN_ID=
NEXT_PUBLIC_EVENT_CAMPAIGN_ID=
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# Optional: deployed Envio HyperIndex GraphQL endpoint
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql

# Optional Scaffold-ETH RPC and WalletConnect settings
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_MONAD_RPC_URL=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
