{
  "name": "viralkit",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "account": "yarn hardhat:account",
    "account:generate": "yarn workspace @viralkit/contracts account:generate",
    "account:import": "yarn workspace @viralkit/contracts account:import",
    "account:reveal-pk": "yarn workspace @viralkit/contracts account:reveal-pk",
    "chain": "yarn hardhat:chain",
    "compile": "yarn hardhat:compile",
    "dev": "yarn workspace @viralkit/web dev",
    "deploy": "yarn hardhat:deploy",
    "fork": "yarn hardhat:fork",
    "format": "yarn next:format && yarn hardhat:format",
    "generate": "yarn account:generate",
    "hardhat:account": "yarn workspace @viralkit/contracts account",
    "hardhat:chain": "yarn workspace @viralkit/contracts chain",
    "hardhat:check-types": "yarn workspace @viralkit/contracts check-types",
    "hardhat:clean": "yarn workspace @viralkit/contracts clean",
    "hardhat:compile": "yarn workspace @viralkit/contracts compile",
    "hardhat:deploy": "yarn workspace @viralkit/contracts deploy",
    "hardhat:flatten": "yarn workspace @viralkit/contracts flatten",
    "hardhat:fork": "yarn workspace @viralkit/contracts fork",
    "hardhat:format": "yarn workspace @viralkit/contracts format",
    "hardhat:generate": "yarn workspace @viralkit/contracts generate",
    "hardhat:hardhat-verify": "yarn workspace @viralkit/contracts hardhat-verify",
    "hardhat:lint": "yarn workspace @viralkit/contracts lint",
    "hardhat:lint-staged": "yarn workspace @viralkit/contracts lint-staged",
    "hardhat:test": "yarn workspace @viralkit/contracts test",
    "hardhat:verify": "yarn workspace @viralkit/contracts verify",
    "postinstall": "husky install",
    "ipfs": "yarn workspace @viralkit/web ipfs",
    "lint": "yarn next:lint && yarn hardhat:lint",
    "next:build": "yarn workspace @viralkit/web build",
    "next:check-types": "yarn workspace @viralkit/web check-types",
    "next:format": "yarn workspace @viralkit/web format",
    "next:lint": "yarn workspace @viralkit/web lint",
    "next:serve": "yarn workspace @viralkit/web serve",
    "precommit": "lint-staged",
    "start": "yarn next:serve",
    "test": "yarn hardhat:test",
    "vercel": "yarn workspace @viralkit/web vercel",
    "vercel:login": "yarn workspace @viralkit/web vercel:login",
    "vercel:yolo": "yarn workspace @viralkit/web vercel:yolo",
    "verify": "yarn hardhat:verify"
  },
  "devDependencies": {
    "husky": "~9.1.6",
    "lint-staged": "~13.2.2"
  },
  "packageManager": "yarn@3.2.3",
  "engines": {
    "node": ">=20.18.3"
  }
}
